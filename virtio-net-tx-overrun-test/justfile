# virtio-net TX overrun test - managed with just
#
# Run from this directory (virtio-net-tx-overrun-test/):
#   just                 list all recipes
#   just doctor          check build/run dependencies
#   just build           build the test app against the Zephyr tree in ZEPHYR_BASE
#   just test            build + run QEMU + assert PASS
#   just test-before     build upstream/main + assert the bug is reproduced (FAIL)
#   just demo            before/after: fixed tree PASS, upstream/main FAIL
#   just qemu            start QEMU manually with the test app
#   just clean           remove build/ and baseline/

set shell := ["bash", "-uc"]

# The test application lives in the same directory as this justfile
app := justfile_directory()

# Zephyr tree under test; override with the ZEPHYR_BASE environment variable
zephyr_base := env_var_or_default("ZEPHYR_BASE", justfile_directory() + "/../../zephyr-virtio")

# run.py only needs the standard library, so plain python3 is fine
python := env_var_or_default("PYTHON", "python3")
qemu := env_var_or_default("QEMU", "qemu-system-riscv64")

board := env_var_or_default("BOARD", "qemu_riscv64")
cpu := env_var_or_default("QEMU_CPU", "rv64i,i=on,m=on,a=on,f=on,d=on,c=on,zicsr=on,zifencei=on,zicntr=on,zkr=on,pmp=on,u=on")
timeout := env_var_or_default("VNET_TIMEOUT", "30")

build_root := justfile_directory() + "/build"
baseline_dir := justfile_directory() + "/baseline"
build_dir := build_root + "/" + file_name(zephyr_base)
elf := build_dir + "/zephyr/zephyr.elf"

# List all available recipes
default:
    @just --list --unsorted

alias run := test

# Show the paths and tools currently in use
info:
    @echo "app          = {{app}}"
    @echo "ZEPHYR_BASE  = {{zephyr_base}}"
    @echo "build dir    = {{build_dir}}"
    @echo "ELF          = {{elf}}"
    @echo "python       = {{python}}"
    @echo "qemu         = {{qemu}}"
    @echo "board        = {{board}}"

# Check that the required tools are available
doctor:
    #!/usr/bin/env bash
    set -uo pipefail
    rc=0
    check() {
        name="$1"; shift
        if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$name"; else printf '  FAIL  %s\n' "$name"; rc=1; fi
    }
    echo "Dependencies:"
    check "just" just --version
    check "cmake" cmake --version
    check "ninja" ninja --version
    check "qemu-system-riscv64" "{{qemu}}" --version
    if [ -f "{{zephyr_base}}/VERSION" ]; then
        echo "  ok    Zephyr tree: {{zephyr_base}}"
    else
        echo "  FAIL  Zephyr tree: {{zephyr_base}} (set ZEPHYR_BASE)"; rc=1
    fi
    if [ -f "{{app}}/CMakeLists.txt" ]; then
        echo "  ok    test app: {{app}}"
    else
        echo "  FAIL  test app: {{app}}"; rc=1
    fi
    if [ -x /tmp/zvenv/bin/python3 ]; then
        PYCHK=/tmp/zvenv/bin/python3
        echo "  ok    build python: /tmp/zvenv/bin/python3"
    else
        PYCHK="$(command -v python3 || true)"
        echo "  warn  /tmp/zvenv not found, build will use: $PYCHK"
    fi
    if [ -n "$PYCHK" ] && "$PYCHK" -c 'import packaging, elftools, yaml, pykwalify' >/dev/null 2>&1; then
        echo "  ok    python build deps"
    else
        echo "  FAIL  python build deps (need packaging, pyelftools, PyYAML, pykwalify)"; rc=1
    fi
    if [ "$rc" -ne 0 ]; then
        echo; echo "Some dependencies are missing, see above."; exit 1
    fi
    echo; echo "All good."

# Build the test app against the current ZEPHYR_BASE tree
build:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{zephyr_base}}/VERSION" ]; then
        echo "ERROR: Zephyr tree not found: {{zephyr_base}}" >&2
        echo "       specify it with ZEPHYR_BASE=/path/to/zephyr just build" >&2
        exit 1
    fi
    if [ -x /tmp/zvenv/bin/python3 ]; then
        export PATH="/tmp/zvenv/bin:$PATH"
    fi
    py="$(command -v python3)"
    echo "==> Building {{elf}}"
    rm -rf "{{build_dir}}"
    export ZEPHYR_BASE="{{zephyr_base}}"
    cmake -GNinja -S "{{app}}" -B "{{build_dir}}" \
        -DBOARD="{{board}}" \
        -DPython3_EXECUTABLE="$py" \
        -DCMAKE_BUILD_TYPE=Debug
    ninja -C "{{build_dir}}"
    echo "==> Built {{elf}}"

# Build a tree that may not be a git checkout (the exported baseline snapshot)
build-tree tree:
    #!/usr/bin/env bash
    set -euo pipefail
    tree="{{tree}}"
    if [ ! -f "$tree/VERSION" ]; then
        echo "ERROR: Zephyr tree not found: $tree" >&2
        exit 1
    fi
    if [ -x /tmp/zvenv/bin/python3 ]; then
        export PATH="/tmp/zvenv/bin:$PATH"
    fi
    py="$(command -v python3)"
    bdir="{{build_root}}/$(basename "$tree")"
    echo "==> Building $bdir/zephyr/zephyr.elf"
    rm -rf "$bdir"
    export ZEPHYR_BASE="$tree"
    ver=""
    if [ ! -e "$tree/.git" ]; then
        ver="-DBUILD_VERSION=upstream-main"
    fi
    cmake -GNinja -S "{{app}}" -B "$bdir" \
        -DBOARD="{{board}}" \
        -DPython3_EXECUTABLE="$py" \
        -DCMAKE_BUILD_TYPE=Debug \
        $ver
    ninja -C "$bdir"
    echo "==> Built $bdir/zephyr/zephyr.elf"

# Build and run the test against the current ZEPHYR_BASE tree (expect PASS)
test: build
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Starting QEMU (expect PASS)"
    QEMU="{{qemu}}" QEMU_CPU="{{cpu}}" VNET_TIMEOUT="{{timeout}}" \
        "{{python}}" "{{app}}/run.py" "{{elf}}" "patched"

# Build and run the test against an explicit Zephyr tree
test-tree tree:
    #!/usr/bin/env bash
    set -euo pipefail
    just build-tree "{{tree}}"
    tree="{{tree}}"
    bdir="{{build_root}}/$(basename "$tree")"
    QEMU="{{qemu}}" QEMU_CPU="{{cpu}}" VNET_TIMEOUT="{{timeout}}" \
        "{{python}}" "{{app}}/run.py" "$bdir/zephyr/zephyr.elf" "$(basename "$tree")"

# Export an upstream/main snapshot into baseline/ (used by test-before and demo)
baseline:
    #!/usr/bin/env bash
    set -euo pipefail
    src="{{zephyr_base}}"
    if [ ! -e "$src/.git" ]; then
        echo "ERROR: baseline needs a git tree: $src" >&2
        exit 1
    fi
    rm -rf "{{baseline_dir}}"
    mkdir -p "{{baseline_dir}}"
    git -C "$src" archive upstream/main | tar -x -C "{{baseline_dir}}"
    echo "==> Baseline (upstream/main) exported to {{baseline_dir}}"

# Build upstream/main and assert the bug is reproduced (RESULT FAIL)
test-before: baseline
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> Building baseline (upstream/main)"
    just build-tree "{{baseline_dir}}"
    echo "==> Starting QEMU on upstream/main (expect FAIL: oversized frame accepted)"
    set +e
    QEMU="{{qemu}}" QEMU_CPU="{{cpu}}" VNET_TIMEOUT="{{timeout}}" \
        "{{python}}" "{{app}}/run.py" "{{build_root}}/baseline/zephyr/zephyr.elf" "upstream/main"
    rc=$?
    set -e
    if [ "$rc" -eq 1 ]; then
        echo "==> OK: bug reproduced on upstream/main (RESULT FAIL as expected)"
        exit 0
    fi
    echo "ERROR: expected the baseline to fail but it passed" >&2
    exit 1

# Before/after: fixed tree PASS, upstream/main FAIL
demo: test test-before
    @echo "==> demo complete: fixed tree PASS, upstream/main FAIL"

# Start QEMU manually with the test app (Ctrl-a x to quit)
qemu: build
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Starting QEMU with the TX overrun test app; Ctrl-a x to quit."
    echo "Expected: RESULT PASS on the fixed tree, RESULT FAIL on upstream/main."
    exec "{{qemu}}" -machine virt -bios none -m 256 -cpu "{{cpu}}" \
        -global virtio-mmio.force-legacy=false \
        -chardev stdio,id=con,mux=on -serial chardev:con \
        -mon chardev=con,mode=readline -nographic -no-reboot \
        -netdev "user,id=n1" \
        -device "virtio-net-device,netdev=n1,bus=virtio-mmio-bus.0" \
        -kernel "{{elf}}"

# Remove build artifacts and the baseline tree
clean:
    rm -rf "{{build_root}}" "{{baseline_dir}}"
